[{
    "height": 20,
    "spacing": 0,

    "modules-left": [
        "group/utilities",
        "group/windows",
	"group/network",
        "mpris"
    ],
    "modules-center": [
        "group/workspaces"
    ],
    "modules-right": [
        "group/cpuram",
    	"group/clock",
        "group/system"
    ],

    "custom/openbracket": {
        "format": "[",
        "tooltip": false
    },
    "custom/closebracket": {
        "format": "]",
        "tooltip": false
    },    
    "custom/split": {
      "format": "|",
      "tooltip": false
    },

    "group/utilities":{
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
            "custom/power",
            "custom/split",
            "idle_inhibitor",
            "custom/bluetooth",
            "custom/closebracket"
        ]
    },
    "custom/power": {
    	"format": "⏻ ",
  	"tooltip": false,
	"on-click": "~/.config/waybar/scripts/power_menu/power_menu.sh",
	"tooltip": "Power Menu"
    },   
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "",
            "deactivated": ""
        }
    },
    "custom/bluetooth": {
    	"format": "",
	"tooltip": false,
	"on-click": "bzmenu --launcher custom --spaces 5 --launcher-command \"rofi -dmenu -i -p '' -theme-str 'window {width: 20%;} element-icon {size: 26px; margin: 0 8 0 16;}'\"",
    },

    "group/network":{
        "orientation": "horizontal",
        "modules":[
            "custom/openbracket",
	    "network",
            "custom/closebracket"
        ]
    },
    "network": {
        "interface": "wlo1",
        "format-wifi": "{icon} |{bandwidthDownBytes} {bandwidthUpBytes}",
        "format-ethernet": "󰈀 LAN",
        "format-disconnected": "󰖪",
        "tooltip-format": "{ipaddr}\n{ssid} ({signalStrength}%)",
        "on-click": "kitty -e nmtui",
        "format-icons": [ "󰤯", "󰤟", "󰤢", "󰤥", "󰤨" ]
    },

    "group/windows": {
        "orientation":"horizontal",
        "modules":[
            "custom/openbracket",
            "hyprland/window",
            "custom/closebracket"
        ]
    },
    "hyprland/window": {
        "format": "{title}", 
        "max-length": 20,
        "min-length": 0,
        "all-outputs": true
    },

    "mpris": {
        "format": "[   {status_icon} | {dynamic} ]",
        "interval": 1,
        "dynamic-len": 40,
        "status-icons": {
            "playing": "▶",
            "paused": "⏸",
            "stopped": ""
        },
        "dynamic-order": ["artist"]
    },

    "group/workspaces":{
        "orientation": "horizontal",
        "modules":[
            "hyprland/workspaces",
        ]
    },

    "hyprland/workspaces": {
	"disable-scroll": true,
	"all-outputs": false,
	"warp-on-scroll": false,
	"sort-by-number": true,
	"show-special": false,
	"on-click": "activate",
	"on-scroll-up": "hyprctl dispatch workspace e+1",
	"on-scroll-down": "hyprctl dispatch workspace e-1",
	"persistent-workspaces": {
		"*": 5
	},
	"format": "<span rise='1200' font_size='7000'>{icon}</span>\u00a0{windows}",
	"format-icons": {
	    "active": "",
	    "default": "",
	},
	"format-window-separator": "|",
	"window-rewrite-default": " ",
	"window-rewrite": {		
		"title<.*amazon.*>": " ",
		"class<firefox|org.mozilla.firefox|librewolf|floorp|mercury-browser|[Cc]achy-browser>": " ",
		"class<zen>": "󰰷 ",
		"class<waterfox|waterfox-bin>": " ",
		"class<microsoft-edge>": " ",
		"class<Chromium|Thorium|[Cc]hrome>": " ",
		"class<tor browser>": " ",
		"class<brave-browser>": "󰒃 ",
		"class<kitty|konsole>": " ",
		"class<kitty-dropterm>": " ",
		"class<com.mitchellh.ghostty>": " ",
		"class<org.wezfurlong.wezterm>": " ",
		"class<[Tt]hunderbird|[Tt]hunderbird-esr>": " ",
		"class<eu.betterbird.Betterbird>": " ",
		"title<.*gmail.*>": "󰊫 ",
		"class<[Tt]elegram-desktop|org.telegram.desktop|io.github.tdesktop_x64.TDesktop>": " ",
		"class<discord|[Ww]ebcord|Vesktop>": " ",
		"title<.*whatsapp.*>": " ",
    		"title<.*zapzap.*>": " ",
		"title<.*messenger.*>": " ",
		"title<.*facebook.*>": " ",
		"title<.*reddit.*>": " ",
		"title<.*ChatGPT.*>": "󰚩 ",
		"title<.*deepseek.*>": "󰚩 ",
		"title<.*qwen.*>": "󰚩 ",
		"class<subl>": "󰅳 ",
		"class<slack>": " ",
		"class<mpv>": " ",
		"class<celluloid|Zoom>": " ",
		"class<Cider>": "󰎆 ",
		"title<.*Picture-in-Picture.*>": " ",
		"title<.*youtube.*>": " ",
		"class<vlc>": "󰕼 ",
		"title<.*cmus.*>": " ",
		"class<[Ss]potify>": " ",
		"class<virt-manager>": " ",
		"class<.virt-manager-wrapped>": " ",
		"class<virtualbox manager>": "💽 ",
		"title<virtualbox>": "💽 ",
		"class<remmina>": "🖥️ ",
		"class<VSCode|code-url-handler|code-oss|codium|codium-url-handler|VSCodium>": "󰨞 ",
    		"class<dev.zed.Zed>": "󰵁",
		"class<codeblocks>": "󰅩 ",
		"title<.*github.*>": " ",
		"class<mousepad>": " ",
		"class<libreoffice-writer>": " ",
		"class<libreoffice-startcenter>": "󰏆 ",
		"class<libreoffice-calc>": " ",
		"title<.*nvim ~.*>": " ",
		"title<.*vim.*>": " ",
		"title<.*nvim.*>": " ",
		"title<.*figma.*>": " ",
		"title<.*jira.*>": " ",
		"class<jetbrains-idea>": " ",
		"class<obs|com.obsproject.Studio>": " ",
		"class<polkit-gnome-authentication-agent-1>": "󰒃 ",
		"class<nwg-look>": " ",
		"class<[Pp]avucontrol|org.pulseaudio.pavucontrol>": "󱡫 ",
		"class<steam>": " ",
		"class<thunar|nemo>": "󰝰 ",	
    		"class<Gparted>":"",
		"class<gimp>": " ",
		"class<android-studio>": " ",
   		"class<org.pipewire.Helvum>": "󰓃",
    		"class<localsend>":"",
    		"class<PrusaSlicer|UltiMaker-Cura|OrcaSlicer>": "󰹛",
	  }
    },


    "group/cpuram": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "cpu",
            "custom/split",
            "memory",
            "custom/closebracket"
        ]
    },
    "cpu": {
        "format": "CPU:{usage}%",
        "tooltip": false,
        "interval": 2,
        "on-click": "kitty -e btop",
    },
    "memory":{
        "format": "RAM:{}%",
        "tooltip": false,
        "interval": 2,
        "on-click": "kitty -e btop",
    },

    "group/clock": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "clock",
            "custom/closebracket"
        ]
    },
    "clock": {
	"format": "{:%I:%M %m.%d}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "on-click" : ""
    },

    "group/system": {
        "orientation": "horizontal",
        "modules": [
            "custom/openbracket",
            "battery",
            "backlight",
            "wireplumber",
            "custom/closebracket"
        ]
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-plugged": " {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "on-click": ""
    },
//    "backlight": {
//        "format": "{icon}:{percent}%",
//        "format-icons": ["", "", "🌙"],
//        "on-click": "~/.config/waybar/scripts/brightness_slider.sh"  
//    },
    "backlight": {
	"interval": 2,
	"align": 0,
	"rotate": 0,
	"format": "{icon} {percent}%",
//	"format-icons": [
//		" ",
//		" ",
//		" ",
//		"󰃝 ",
//		"󰃞 ",
//		"󰃟 ",
//		"󰃠 "
//	],
//	"format": "{icon}",
	"format-icons": ["","","","","","","","","","","","","","",""],
	//"tooltip-format": "backlight {percent}%",
	//"icon-size": 10,
	"on-click": "",
	"on-click-middle": "",
	"on-click-right": "",
	"on-update": "",
	"on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
	"on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
	"smooth-scrolling-threshold": 1,
    },
    "wireplumber": {
	"format": "{icon} {volume}%",
	"format-bluetooth": "{icon} 󰂰 {volume}%",
	"format-muted": "󰖁 ",
	"format-icons": {
		"headphone": "",
		"hands-free": "",
		"headset": "",
		"phone": "",
		"portable": "",
		"car": "",
		"default": [
			"", "", "󰕾",  ""
		],
		"ignored-sinks": [
			"Easy Effects Sink"
		],
	},
	"scroll-step": 5.0,
	"on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
	"on-click-right": "pavucontrol -t 3",
	"on-scroll-up": "wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ 5%+",
	"on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-",
	"tooltip-format": "{icon} {desc} | {volume}%",
	"smooth-scrolling-threshold": 1,
    }
}]
