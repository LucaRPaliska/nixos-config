{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "small",
        "color": {
            "1": "white",
            "2": "white"
        }
    },

    "display": {
        "separator": "  →  ",
        "color": {
            "keys": "white",
            "title": "white",
            "output": "white"
        }
    },

    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        "separator",
        "os",
        "kernel",
        "uptime",
        "shell",
        "display",
        "wm",
        "cpu",
        "gpu",
        "memory",
        "disk",
        "battery",
        "separator",
        "colors"
    ]
}
